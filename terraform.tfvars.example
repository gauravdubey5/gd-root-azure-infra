environment         = "dev"
location            = "eastus2"
resource_group_name = "rg-gd-infra-dev-001"
vnet_name           = "vnet-gd-infra-dev-001"
vnet_address_space  = ["10.10.0.0/16"]
nsg_name            = "nsg-gd-infra-dev-001"

subnets = {
  "snet-workload-01" = {
    address_prefixes  = ["10.10.1.0/24"]
    associate_nsg     = true
    service_endpoints = ["Microsoft.Storage", "Microsoft.KeyVault"]
  }
}

tags = {
  Owner = "Gaurav"
}
