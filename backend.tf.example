# Example remote backend configuration using Azure Blob Storage.
# Rename to backend.tf or pass backend configuration parameters dynamically via:
# terraform init -backend-config="resource_group_name=<RG>" \
#                -backend-config="storage_account_name=<STORAGE_ACCOUNT>" \
#                -backend-config="container_name=tfstate" \
#                -backend-config="key=dev.terraform.tfstate"

terraform {
  backend "azurerm" {
    resource_group_name  = "rg-terraform-state-eastus2"
    storage_account_name = "sttfstategd001"
    container_name       = "tfstate"
    key                  = "gd-parent-infra/dev.tfstate"
    use_azuread_auth     = true
  }
}
